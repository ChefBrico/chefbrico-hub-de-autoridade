{# Este é o "molde" principal para uma página de Fragmento Citável #}
{% extends "../base.njk" %} {# Ele usa o seu design base (cabeçalho/rodapé) #}

{# --- Seção do HEAD (Onde a Mágica do Schema Acontece) --- #}
{% block head_scripts %}
  <script type="application/ld+json">
  {# Puxa o "motor" do schema #}
  {% include "schema-fragmento.njk" %}
  </script>
{% endblock %}

{# --- Seção do Conteúdo (TESTE DIRETO) --- #}
{% block content %}
  <main style="border: 5px solid blue; padding: 30px; margin: 20px;">
    <h2>--- TESTE DIRETO NO LAYOUT ---</h2>
    
    <p>Este texto ESTÁ DENTRO do layout fragmento-page.</p>
    
    <p>O Título (da variável 'title') é:</p>
    <h1 style="background-color: yellow;">{{ title }}</h1> 
    
    <p>O Texto do Fragmento (da variável 'fragmento_texto') é:</p>
    <div style="background-color: lightgreen; padding: 15px;">
        {{ fragmento_texto | safe }}
    </div>

    <h2>--- FIM DO TESTE DIRETO ---</h2>
  </main>
{% endblock %}
