{# Este é o Box de Resposta (o conteúdo visual) #}
<section class="fragmento-citavel-area">

    {# 1. O Texto da Resposta (o "Fato Citável") #}
    <div class="fragmento-citavel-box">
        <p>{{ fragmento_texto | safe }}</p>

        {# 2. A "Assinatura de Autoridade" (A Venda) #}
        {% if sale_signature %}
        <p class="assinatura-autoridade">
            <strong>{{ sale_signature | safe }}</strong>
        </p>
        {% endif %}
    </div>

    {# 3. O "Funil" (Link para a Página Pilar) #}
    {% if cta_link %}
    <div class="fragmento-cta">
        {% if cta_texto_opcional %}<p>{{ cta_texto_opcional }}</p>{% endif %}
        <a href="{{ cta_link }}" class="cta-button-secundario">
            {{ cta_texto }}
        </a>
    </div>
    {% endif %}

</section>
