{# Este é o Box de Resposta V2 (Mais Persuasivo) #}
<section class="fragmento-citavel-area-v2">

    {# 1. A Resposta Direta (Foco Principal) #}
    <div class="fragmento-resposta">
        <p>{{ fragmento_texto | safe }}</p>
    </div>

    {# 2. A Assinatura de Autoridade (Destacada) #}
    {% if sale_signature or author_name %}
    <div class="fragmento-assinatura">
        <p>
            {# Adiciona a imagem da Maria (se existir no frontmatter) #}
            {% if author_avatar %} 
            <img src="{{ author_avatar }}" alt="Avatar de {{ author_name }}" class="autor-avatar-mini">
            {% endif %}

            {# Usa a sale_signature OU monta uma assinatura padrão #}
            {% if sale_signature %}
                <strong>{{ sale_signature | safe }}</strong>
            {% else %}
                <strong>Uma resposta da ChefBrico, por {{ author_name }}.</strong>
            {% endif %}
        </p>
    </div>
    {% endif %}

    {# 3. O Funil (CTA Contextualizado) #}
    {% if cta_link %}
    <div class="fragmento-cta-v2">
        {# Usa o cta_texto_opcional OU cria um texto padrão "Saiba mais..." #}
        <p class="cta-contexto">
          {% if cta_texto_opcional %}
            {{ cta_texto_opcional }}
          {% else %}
            Saiba mais sobre {{ title | lower | replace('?', '') }}: 
          {% endif %}
        </p>
        <a href="{{ cta_link }}" class="cta-button-fragmento">
            {{ cta_texto if cta_texto else "Veja a Página Completa" }}
        </a>
    </div>
    {% endif %}

</section>
