---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
    {%- for page in collections.all %}
        {# A CONDIÇÃO ABAIXO AGORA É MUITO MAIS INTELIGENTE #}
        {%- if
            page.url and
            page.data.eleventyExcludeFromCollections != true and
            not page.url.includes('/admin/') and
            page.url != "/README/" and
            page.url != "/catalogo/"
        %}
    <url>
        <loc>https://receitas.chefbrico.com{{ page.url | url }}</loc>
        <lastmod>{{ page.date.toISOString().split('T')[0] }}</lastmod>
    </url>
        {%- endif %}
    {%- endfor %}
</urlset>
